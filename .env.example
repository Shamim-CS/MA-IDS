# Copy this file to .env and fill in your values. Never commit .env.

# API key for the LLM endpoint. The default endpoint in config.py is OpenRouter
# (https://openrouter.ai/api/v1), so use an OpenRouter key here.
OPENAI_API_KEY=your-api-key-here

# Where the Experience Library (FAISS index) is stored or created
BRAIN_PATH=brain/experience_library

# Path to the NetFlow CSV (e.g. NF-ToN-IoT or NF-BoT-IoT)
DATA_FILE=data/train.csv
